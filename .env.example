# Copy to .env (gitignored) and fill in what you use. Everything is optional: with nothing set,
# flighttruth still runs on the free sources (ADS-B feeds, the Ben Gurion and Aena boards).

# --- Server -----------------------------------------------------------------
# Loopback by default. The API has no auth and adding a trip can trigger paid scrapes, so only
# bind to an address you alone can reach (a VPN interface), never a public one.
HOST=127.0.0.1
PORT=3000
# SQLite file; default ~/.local/share/flighttruth/flighttruth.db
# FLIGHTTRUTH_DB=/path/to/flighttruth.db
# Base URL of this server as your phone reaches it, used as the link in pushes.
# FLIGHTTRUTH_URL=http://my-server:3000

# --- Pushes -----------------------------------------------------------------
# An ntfy.sh topic. Anyone who knows it can read your pushes, so make it long and random.
NTFY_TOPIC=

# --- Paid or keyed sources (each switches one source on) ------------------------
# Bright Data: Google's flight card plus the scraped FlightAware, Flightradar24 and FlightStats
# pages. Billed per request.
BRIGHTDATA_API_KEY=
# Bright Data zone names, if yours differ from these defaults.
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker
BRIGHTDATA_SERP_ZONE=serp_api1
# Bright Data Browser API (wss://...), for airline sites that need a real browser (Etihad).
BRIGHTDATA_BROWSER_WSS=
# FlightAware AeroAPI. A small free monthly credit, billed per call beyond it.
AEROAPI_KEY=
# AeroDataBox via RapidAPI. The free plan allows a few hundred calls a month.
AERODATABOX_KEY=
